{
  "productName": "SubsForge",
  "version": "1.0.0",
  "identifier": "com.subsforge.app",
  "build": {
    "frontendDist": "../src/webui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SubsForge",
        "width": 1060,
        "height": 710,
        "minWidth": 920,
        "minHeight": 610,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/autosubs-core"
    ]
  }
}
